{
  "name": "algopulse-app",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoPulse full-stack PoC (React + Vite client, Express + MariaDB server)",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix server run dev",
    "dev:frontend": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
